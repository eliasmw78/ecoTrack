generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  prenom       String
  nom          String
  role         Role           @default(USER)
  created_at   DateTime       @default(now())
  consumptions Consommation[]
}

model TypeEnergie {
  id           Int            @id @default(autoincrement())
  libelle      String
  unite        String
  consumptions Consommation[]
}

model Consommation {
  id          Int         @id @default(autoincrement())
  valeur      Float
  cout        Float       @default(0)
  factureUrl  String?
  date        DateTime
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  typeId      Int
  typeEnergie TypeEnergie @relation(fields: [typeId], references: [id])
}
